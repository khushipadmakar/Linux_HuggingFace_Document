# Local default (works out-of-box)
AIDOC_DATABASE_URL=sqlite:///./storage/document_intelligence.db

# For PostgreSQL (production/real DB), replace above with:
# AIDOC_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/document_intelligence_db

# Keep false unless pgvector extension is installed in PostgreSQL
AIDOC_USE_PGVECTOR=false

AIDOC_UPLOAD_ROOT=storage/uploads
AIDOC_LOG_ROOT=storage/logs
AIDOC_BACKUP_ROOT=storage/backups

# Hugging Face models
AIDOC_HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AIDOC_HF_SUMMARY_MODEL=sshleifer/distilbart-cnn-12-6
AIDOC_HF_QA_MODEL=deepset/roberta-base-squad2
